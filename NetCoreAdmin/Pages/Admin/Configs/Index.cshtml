@page
@model NetCoreAdmin.Pages.Admin.Configs.IndexModel
@{
    ViewData["Title"] = "系统参数";
}
<div class="page-heading"><div><div class="eyebrow">SYSTEM</div><h1>系统参数</h1><p>维护应用级键值配置。请勿在此存储明文密钥或密码。</p></div></div>
@if (!string.IsNullOrEmpty(Model.Message)) { <div class="alert-success">@Model.Message</div> }
<section class="panel"><div class="panel-heading"><div><h2>新增参数</h2><p>参数键应唯一</p></div></div><form method="post" class="inline-form"><label>参数键<input asp-for="Input.Key" required maxlength="128" /></label><label>参数值<input asp-for="Input.Value" maxlength="1000" /></label><label>说明<input asp-for="Input.Description" maxlength="500" /></label><button class="button button-primary" type="submit">保存参数</button></form><div class="table-wrap top-gap"><table><thead><tr><th>参数键</th><th>值</th><th>说明</th><th>状态</th></tr></thead><tbody>@foreach (var config in Model.Configs) { <tr><td><code>@config.Key</code></td><td>@config.Value</td><td>@(config.Description ?? "—")</td><td><span class="badge badge-green">@(config.IsEnabled ? "启用" : "停用")</span></td></tr> }</tbody></table></div></section>
