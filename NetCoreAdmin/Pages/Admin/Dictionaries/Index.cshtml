@page
@model NetCoreAdmin.Pages.Admin.Dictionaries.IndexModel
@{
    ViewData["Title"] = "字典管理";
}
<div class="page-heading"><div><div class="eyebrow">SYSTEM</div><h1>字典管理</h1><p>字典类型与字典项为一对多结构：每个字典项关联一个类型。</p></div></div>
@if (!string.IsNullOrEmpty(Model.Message)) { <div class="alert-success">@Model.Message</div> }
<div class="content-grid"><section class="panel"><div class="panel-heading"><div><h2>新建字典类型</h2><p>例如：性别、订单状态</p></div></div><form method="post" asp-page-handler="CreateType" class="form-stack compact-form"><label>类型名称<input asp-for="TypeInput.Name" required maxlength="100" /></label><label>类型代码<input asp-for="TypeInput.Code" required maxlength="64" /></label><button class="button button-primary" type="submit">创建类型</button></form></section>
<section class="panel"><div class="panel-heading"><div><h2>字典类型</h2><p>@Model.Types.Count 个类型</p></div></div><div class="table-wrap"><table><thead><tr><th>名称</th><th>代码</th><th>状态</th></tr></thead><tbody>@foreach (var item in Model.Types) { <tr><td><strong>@item.Name</strong></td><td><code>@item.Code</code></td><td><span class="badge badge-green">@(item.IsEnabled ? "启用" : "停用")</span></td></tr> }</tbody></table></div></section></div>
<section class="panel spaced-panel"><div class="panel-heading"><div><h2>新建字典项</h2><p>将选项添加到已有字典类型</p></div></div><form method="post" asp-page-handler="CreateItem" class="inline-form"><label>字典类型<select asp-for="ItemInput.DictionaryTypeId" required><option value="">请选择</option>@foreach (var type in Model.Types) { <option value="@type.Id">@type.Name (@type.Code)</option> }</select></label><label>显示名称<input asp-for="ItemInput.Label" required maxlength="100" /></label><label>代码<input asp-for="ItemInput.Code" required maxlength="64" /></label><label>值<input asp-for="ItemInput.Value" maxlength="256" /></label><button class="button button-primary" type="submit">添加字典项</button></form><div class="table-wrap top-gap"><table><thead><tr><th>字典类型</th><th>显示名称</th><th>代码</th><th>值</th><th>状态</th></tr></thead><tbody>@foreach (var item in Model.Items) { <tr><td>@(Model.Types.FirstOrDefault(x => x.Id == item.DictionaryTypeId)?.Name ?? "(类型已删除)")</td><td>@item.Label</td><td><code>@item.Code</code></td><td>@(item.Value ?? "—")</td><td><span class="badge badge-green">启用</span></td></tr> }</tbody></table></div></section>
